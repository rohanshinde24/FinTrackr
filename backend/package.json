{
  "name": "fintrackr-backend",
  "version": "1.0.0",
  "description": "FinTrackr Backend API - Personal Finance Management System",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "typeorm": "typeorm-ts-node-commonjs -d src/config/database.ts",
    "db:migrate": "npm run typeorm -- migration:run",
    "db:migrate:prod": "typeorm -d dist/config/database.js migration:run",
    "db:revert": "npm run typeorm -- migration:revert",
    "db:show": "npm run typeorm -- migration:show",
    "db:generate": "npm run typeorm -- migration:generate"
  },
  "keywords": [
    "finance",
    "tracker",
    "api",
    "nodejs",
    "typescript",
    "postgresql"
  ],
  "author": "Rohan Shinde",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "pg": "^8.11.3",
    "typeorm": "^0.3.17",
    "reflect-metadata": "^0.1.13",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "@types/node": "^20.8.0",
    "@types/express": "^4.17.20",
    "@types/cors": "^2.8.15",
    "@types/morgan": "^1.9.9",
    "@types/bcryptjs": "^2.4.5",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/pg": "^8.10.7",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.6",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.15"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
