{
  "name": "fintrackr-backend",
  "resourceGroup": "fintrackr-rg",
  "location": "eastus",
  "sku": "B1",
  "runtime": "NODE|18-lts",
  "appSettings": {
    "NODE_ENV": "production",
    "PORT": "8080",
    "WEBSITES_PORT": "8080",
    "SCM_DO_BUILD_DURING_DEPLOYMENT": "true",
    "WEBSITE_NODE_DEFAULT_VERSION": "~18"
  },
  "connectionStrings": {
    "defaultConnection": {
      "type": "PostgreSQL",
      "value": "Server=<DB_HOST>;Database=<DB_NAME>;Port=5432;User Id=<DB_USER>;Password=<DB_PASSWORD>;Ssl Mode=Require;"
    }
  }
}

